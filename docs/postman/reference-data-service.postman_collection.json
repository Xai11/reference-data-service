  "item": [
    {
      "name": "Создать справочник COUNTRY",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dictionaries"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"COUNTRY\",\n  \"name\": \"Страны\",\n  \"description\": \"Справочник стран\",\n  \"active\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('countryId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
