    {
      "name": "Расширенные возможности",
      "item": [
        {
          "name": "Создать иерархический справочник REGION",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/dictionaries"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"REGION\",\n  \"name\": \"Регионы\",\n  \"description\": \"Административное деление\",\n  \"active\": true,\n  \"hierarchical\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('regionId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Атрибут population (число)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
