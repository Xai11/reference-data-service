            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"population\",\n  \"name\": \"Население\",\n  \"type\": \"NUMBER\",\n  \"required\": false,\n  \"sortOrder\": 1\n}"
            }
          }
        },
